# Google Gemini API Key (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# SEC EDGAR requires a User-Agent header in format: Name email@domain.com
SEC_EDGAR_USER_AGENT=FinancialResearchAgent user@example.com

# Server Configuration
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000", "http://127.0.0.1:8000"]
